[Unit]
Description=B.E.E.R.C.A.D.E. Operations & Supervisory System (B.O.S.S.) Daemon
After=network-online.target systemd-networkd.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/share/boss
Environment=BOSS_HOST=0.0.0.0
Environment=BOSS_PORT=8989
Environment=BOSS_NETPLAY_UDP_PORT=9750
Environment=BOSS_STATIC_DIR=/usr/share/boss/kiosk_ui
Environment=BOSS_SYNC_DIR=/data/beercade/sync
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/boss-server
Restart=always
RestartSec=3s
LimitNOFILE=65536

# Security Hardening
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target

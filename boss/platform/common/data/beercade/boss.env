# B.O.S.S. venue server configuration (/data/beercade/boss.env)
# Blank secrets are populated atomically with CSPRNG values on first boot by
# beercade-provision-secrets.service (0640 root:boss).
BOSS_RPC_TOKEN=
BOSS_NODE_TOKEN=
BOSS_OPERATOR_PIN=
BOSS_PORT=8080
BOSS_VENUE_NAME="Beercade Redfern (The BK)"
BOSS_VENUE_ADDRESS="113-115 Regent St, Redfern NSW 2016"

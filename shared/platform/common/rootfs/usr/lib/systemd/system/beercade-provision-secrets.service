[Unit]
Description=Beercade First-Boot CSPRNG Secret Provisioning
DefaultDependencies=no
After=local-fs.target beercade-grow-data.service systemd-tmpfiles-setup.service
Before=boss-server.service astro-daemon.service
ConditionPathExists=|/data/beercade/boss.env
ConditionPathExists=|/data/beercade/astro.env

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/beercade-provision-secrets.sh

[Install]
WantedBy=multi-user.target

# /beercade-src/Dockerfile.buildfarm
FROM archlinux:base-devel

RUN pacman -Syu --noconfirm --needed && \
    pacman -S --noconfirm --needed \
    aarch64-linux-gnu-gcc \
    aarch64-linux-gnu-glibc \
    aarch64-linux-gnu-binutils \
    git base-devel bc python cmake ninja meson \
    dtc cpio squashfs-tools pkgconf wget uboot-tools \
    libisoburn dosfstools mtools clang llvm rust spirv-llvm-translator \
    libdrm libglvnd wayland-protocols alsa-lib libxkbcommon python-packaging python-mako python-yaml python-ply

RUN useradd -m -G wheel -s /bin/bash builder && \
    echo "%wheel ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER builder
WORKDIR /beercade-src

ENV CFLAGS="-O3 -march=armv8.2-a+crypto+fp16+dotprod -mtune=cortex-a76 -flto=auto -ffunction-sections -fdata-sections -fomit-frame-pointer -funroll-loops"
ENV CXXFLAGS="-O3 -march=armv8.2-a+crypto+fp16+dotprod -mtune=cortex-a76 -flto=auto -ffunction-sections -fdata-sections -fomit-frame-pointer -funroll-loops"
ENV LDFLAGS="-Wl,--gc-sections -Wl,-O1 -Wl,--as-needed"
ENV ARCH="arm64"
ENV CROSS_COMPILE="aarch64-linux-gnu-"

CMD ["/bin/bash"]

{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "beercade-website",
	"compatibility_date": "2026-08-04",
	"compatibility_flags": ["nodejs_als"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"vars": {
		// URL of the B.O.S.S. multiplexed SSE hub behind the Cloudflare Tunnel.
		// Consumed by /api/v1/edge/stream to proxy live telemetry to browsers.
		"BOSS_SSE_URL": "http://localhost:8989/api/telemetry/stream",
		// Shared secret BOSS presents when POSTing batches to /api/v1/edge/ingest.
		// DEV DEFAULT ONLY — override in production with:
		//   npx wrangler pages secret put EDGE_INGEST_TOKEN
		"EDGE_INGEST_TOKEN": "bk-dev-edge-token-2026"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "beercade-db",
			"database_id": "local-d1-id"
		}
	],
	"kv_namespaces": [
		{
			"binding": "TELEMETRY_KV",
			"id": "local-kv-id"
		}
	]
}


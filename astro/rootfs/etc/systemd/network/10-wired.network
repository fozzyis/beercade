[Match]
Name=eth* en* end* lan*
Type=ether

[Network]
Address=192.168.100.2/24
Gateway=192.168.100.1
DNS=192.168.100.1 1.1.1.1 8.8.8.8
DNSSEC=no
MulticastDNS=yes
DHCP=yes
LinkLocalAddressing=fallback
LLDP=no
EmitLLDP=no
IPv6AcceptRA=no
ConfigureWithoutCarrier=yes

[DHCPv4]
RouteMetric=100
UseDNS=yes

[Unit]
Description=A.S.T.R.O. node daemon
After=network.target local-fs.target astro-tune.service

[Service]
Type=simple
Environment=ASTRO_STANDALONE=0
EnvironmentFile=-/data/beercade/astro.env
ExecStart=/usr/bin/astro-daemon
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=A.S.T.R.O. customer screen (astro-shell on KMS, tty1)
After=astro-tune.service astro-daemon.service local-fs.target
RequiresMountsFor=/data
Conflicts=getty@tty1.service
OnFailure=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
Slice=astro-rt.slice
WorkingDirectory=/data/beercade
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
Environment=XDG_CACHE_HOME=/data/beercade/cache
Environment=MESA_SHADER_CACHE_DIR=/data/beercade/cache/mesa
EnvironmentFile=-/data/beercade/astro.env
ExecStart=/bin/sh /usr/lib/beercade/astro_frontend_start.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

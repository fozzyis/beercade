[Unit]
Description=A.S.T.R.O. latency tuning (governor, CPU partitioning, PM QoS)
Wants=astro-rt.slice
After=local-fs.target astro-rt.slice
Before=astro-daemon.service astro-frontend.service display-manager.service

[Service]
Type=notify
ExecStart=/usr/bin/astro-tune
Restart=on-failure

[Install]
WantedBy=multi-user.target

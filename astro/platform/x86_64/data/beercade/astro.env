# A.S.T.R.O. station configuration (/data/beercade/astro.env)
ASTRO_STANDALONE=0
ASTRO_NODE_ID=ASTRO-01
# Primary target, with automatic fallback across mDNS and static LAN
BOSS_ENDPOINT=http://192.168.100.10:8080
# Provisioned on first boot (or via signed B.O.S.S. discovery) — never ship dev defaults
BOSS_NODE_TOKEN=
ASTRO_DISCOVERY_KEY=

# Attraction Mode: "random" picks a game from /data/beercade/roms/snes on boot,
# or set to "none" to keep the customer shell in idle/attract.
ASTRO_ATTRACT_ROM=random

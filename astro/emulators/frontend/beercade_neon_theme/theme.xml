<!-- ===================================================================== -->
<!-- B.E.E.R.C.A.D.E. "Neon Arcade" Theme for ES-DE (KMSDRM Direct Mode)     -->
<!-- Optimized for RK3588S / Mali-G610: Pre-cached vector assets, 60fps UI   -->
<!-- ===================================================================== -->
<theme>
    <formatVersion>7</formatVersion>
    
    <view name="system">
        <text name="logoText">
            <fontPath>/usr/share/fonts/TTF/DejaVuSans-Bold.ttf</fontPath>
            <fontSize>0.08</fontSize>
            <color>00FFCC</color>
            <glowColor>0088FF44</glowColor>
            <glowSize>4</glowSize>
            <alignment>center</alignment>
        </text>
        
        <carousel name="systemcarousel">
            <pos>0.0 0.4</pos>
            <size>1.0 0.3</size>
            <type>horizontal</type>
            <color>101216EE</color>
            <logoScale>1.2</logoScale>
            <logoSize>0.25 0.25</logoSize>
            <logoAlignment>center</logoAlignment>
        </carousel>
        
        <text name="systemInfo">
            <pos>0.1 0.75</pos>
            <size>0.8 0.15</size>
            <fontPath>/usr/share/fonts/TTF/DejaVuSans.ttf</fontPath>
            <fontSize>0.035</fontSize>
            <color>E0E6ED</color>
            <alignment>center</alignment>
        </text>
    </view>

    <view name="basic, detailed, grid">
        <textlist name="gamelist">
            <pos>0.05 0.15</pos>
            <size>0.45 0.75</size>
            <fontPath>/usr/share/fonts/TTF/DejaVuSans.ttf</fontPath>
            <fontSize>0.032</fontSize>
            <primaryColor>00FFCC</primaryColor>
            <secondaryColor>FF007F</secondaryColor>
            <selectorColor>00FFCC33</selectorColor>
            <selectedColor>FFFFFF</selectedColor>
        </textlist>
        
        <image name="md_image">
            <pos>0.55 0.18</pos>
            <maxSize>0.4 0.4</maxSize>
            <origin>0.0 0.0</origin>
        </image>
        
        <text name="md_description">
            <pos>0.55 0.62</pos>
            <size>0.4 0.28</size>
            <fontPath>/usr/share/fonts/TTF/DejaVuSans.ttf</fontPath>
            <fontSize>0.025</fontSize>
            <color>CCCCCC</color>
        </text>
    </view>
</theme>

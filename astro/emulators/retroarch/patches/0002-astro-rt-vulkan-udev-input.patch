@@ -39,6 +39,11 @@
 #include "../../verbosity.h"
 #include "../../configuration.h"
 
+#ifdef HAVE_ASTRO_RT_INPUT
+/* Beercade A.S.T.R.O. 1000 Hz evdev input ABI (-lastro_rt). */

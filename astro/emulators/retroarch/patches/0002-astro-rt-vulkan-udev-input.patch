 #include <windows.h>
 #endif
@@ -2644,6 +2649,22 @@ void vulkan_context_destroy(gfx_ctx_vulkan_data_t *vk,
    }
 }
 
+#ifdef HAVE_ASTRO_RT_INPUT
+/* Drain the 1000 Hz SPSC evdev ring immediately before VSync/swap presentation
+ * (used by khr_display and Vulkan WSI context drivers).  Preallocated static
+ * batch buffer: no heap allocations and no locks in the hot path. */
+static void astro_vulkan_input_drain_pre_present(void)
+{
+   static struct astro_input_event batch[ASTRO_INPUT_DRAIN_MAX];
+
+   (void)astro_input_drain(batch, ASTRO_INPUT_DRAIN_MAX);
+}
+#else
+static void astro_vulkan_input_drain_pre_present(void)
+{
+}
+#endif
+

 #include "../../verbosity.h"
 #include "../common/drm_common.h"
 
+#ifdef HAVE_ASTRO_RT_INPUT
+/* Beercade A.S.T.R.O. 1000 Hz evdev input ABI.  Build with -lastro_rt and

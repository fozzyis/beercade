#!/usr/bin/ash
run_hook() {
    modprobe overlay
    mkdir -p /lower /overlay /overlay/upper /overlay/work /new_root

    # Mount base root as read-only lower filesystem
    mount -o ro "${root}" /lower

    # Mount temporary RAM overlay for transient writes
    mount -t tmpfs tmpfs /overlay
    mkdir -p /overlay/upper /overlay/work

    # Union mount
    mount -t overlay overlay -o lowerdir=/lower,upperdir=/overlay/upper,workdir=/overlay/work /new_root

    # Ensure persistent arcade storage mount point exists
    mkdir -p /new_root/data
}
